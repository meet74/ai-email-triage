# Triage service settings. Copy to .env and edit. With no API key the service
# uses the built-in deterministic mock model, so everything runs for free.

# anthropic (default), openai (any OpenAI-compatible API) or mock
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Override to point at a proxy or a self-hosted OpenAI-compatible server
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# If set, requests to the service must send this value in X-API-Key
TRIAGE_API_KEY=

# Bodies are cut to this many characters before they reach the model
MAX_BODY_CHARS=6000
LOG_LEVEL=INFO

# n8n side (set in n8n, not in this service): Slack signing secret is stored as
# an n8n credential value or in the Config node of the approval workflow.
